[sub_resource type="GDScript" id="GDScript_ec27v"]
resource_name = "ColorRotator"
script/source = "extends ClickableArea

@onready var color_rect: ColorRect = $color_target

var _state: int = 0

func click_action():
	match _state:
		0:
			color_rect.color = Color()
			_state+=1
		1:
			color_rect.color = Color(\"202020ff\")
			_state+=1
		2:
			color_rect.color = Color(\"404040ff\")
			_state+=1
		3:
			color_rect.color = Color(\"606060ff\")
			_state+=1
		4:
			color_rect.color = Color(\"808080ff\")
			_state+=1
		5:
			color_rect.color = Color(\"a0a0a0ff\")
			_state+=1
		6:
			color_rect.color = Color(\"c0c0c0ff\")
			_state+=1
		6:
			color_rect.color = Color(\"e0e0e0ff\")
			_state+=1
		7:
			color_rect.color = Color(1.0, 1.0, 1.0, 1.0)
			_state=0
"

[sub_resource type="GDScript" id="GDScript_ja8k3"]
resource_name = "RotatorControls"
script/source = "extends ClickableArea

@onready var to_rotate: Control = $to_rotate
@onready var sfx: AudioStreamPlayer2D = $sfx

var spin = 1

func click_action() -> void:
	spin = spin * -1
func hover_end_action() -> void:
	sfx.play()

func _process(delta: float) -> void:
	if not is_hovering:
		return
	to_rotate.rotation_degrees = to_rotate.rotation_degrees + (spin*90*delta)
"

