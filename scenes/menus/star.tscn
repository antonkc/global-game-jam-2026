[sub_resource type="GDScript" id="GDScript_u0vfv"]
script/source = "extends Control

@onready var star_area: Control = $star_area

var action: Callable = __default_action:
	set(new_fn):
		if new_fn == null:
			action = __default_action
		else:
			action = new_fn

func __default_action():
	print(\"star '%s' acted!\" % self.get_path())
"

