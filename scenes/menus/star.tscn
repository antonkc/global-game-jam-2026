[sub_resource type="GDScript" id="GDScript_jwf60"]
script/source = "@tool
extends ClickableArea

@export var animation_duration: float = 6.0
@export var curve_00: Curve
@export var curve_01: Curve
@export var curve_02: Curve
@export var curve_03: Curve
@export var curve_04: Curve
@export var curve_05: Curve

@onready var tween_00: Tween = create_tween().set_loops()
@onready var tween_01: Tween = create_tween().set_loops()
@onready var tween_02: Tween = create_tween().set_loops()
@onready var tween_03: Tween = create_tween().set_loops()
@onready var tween_04: Tween = create_tween().set_loops()
@onready var tween_05: Tween = create_tween().set_loops()

var action: Callable = __default_action:
	set(new_fn):
		if new_fn == null:
			action = __default_action
		else:
			action = new_fn

func _ready() -> void:
	tween_00.tween_property($star00, \"rotation_degrees\", 360, animation_duration).from(0).set_custom_interpolator(_interpolation_00)
	tween_01.tween_property($star01, \"rotation_degrees\", 360, animation_duration).from(0).set_custom_interpolator(_interpolation_01)
	tween_02.tween_property($star02, \"rotation_degrees\", 360, animation_duration).from(0).set_custom_interpolator(_interpolation_02)
	tween_03.tween_property($star03, \"rotation_degrees\", 360, animation_duration).from(0).set_custom_interpolator(_interpolation_03)
	tween_04.tween_property($star04, \"rotation_degrees\", 360, animation_duration).from(0).set_custom_interpolator(_interpolation_04)
	tween_05.tween_property($star05, \"rotation_degrees\", 360, animation_duration).from(0).set_custom_interpolator(_interpolation_05)
func _interpolation_00(normal: float):
	return curve_00.sample(normal)
func _interpolation_01(normal: float):
	return curve_01.sample(normal)
func _interpolation_02(normal: float):
	return curve_02.sample(normal)
func _interpolation_03(normal: float):
	return curve_03.sample(normal)
func _interpolation_04(normal: float):
	return curve_04.sample(normal)
func _interpolation_05(normal: float):
	return curve_05.sample(normal)

func click_action() -> void:
	action.call()
func hover_action() -> void: # Remember to call hover_end action if needed
	tween_00.set_speed_scale(5)
	tween_01.set_speed_scale(5)
	tween_02.set_speed_scale(5)
	tween_03.set_speed_scale(5)
	tween_04.set_speed_scale(5)
	tween_05.set_speed_scale(5)
func hover_end_action() -> void:
	tween_00.set_speed_scale(1)
	tween_01.set_speed_scale(1)
	tween_02.set_speed_scale(1)
	tween_03.set_speed_scale(1)
	tween_04.set_speed_scale(1)
	tween_05.set_speed_scale(1)

func __default_action():
	print(\"%s acted!\" % self.get_path())
"

